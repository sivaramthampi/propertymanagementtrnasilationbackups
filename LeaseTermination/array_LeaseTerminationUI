              border-radius: 0 8px 8px 0;
              padding: 12px 14px;
              font-size: 13px;
              color: #7b1515;
              line-height: 1.6;
            ">
            This action cannot be undone. All records will be updated, documents
            generated, and the lease will be marked as
            <strong>Terminated</strong>.
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" onclick="LT.closeModal('submitConfirmModal')">
            Cancel
          </button>
          <button class="btn btn-primary" onclick="LT.submitTermination()">
            ✔ Confirm &amp; Submit
          </button>
        </div>
      </div>
    </div>
    <!-- ===== STAGE 4 SKIP DEPOSIT SAVE MODAL ===== -->
    <div class="modal" id="depositSkipModal">
      <div class="modal-content" style="max-width: 480px">
        <div class="modal-header" style="background: linear-gradient(135deg, #7b1515, #a61c1c)">
          <div class="modal-title">⚠️ Deposit Changes Not Saved</div>
          <button class="modal-close" onclick="LT.closeModal('depositSkipModal')">
            ×
          </button>
        </div>
        <div class="modal-body">
          <div style="
              background: #fffbeb;
              border: 1px solid #fde68a;
              border-left: 3px solid #f59e0b;
              border-radius: 0 8px 8px 0;
              padding: 14px 16px;
              font-size: 13px;
              color: #92400e;
              line-height: 1.7;
              margin-bottom: 14px;
            ">
            <strong>Your deposit selections have not been saved yet.</strong><br>
            If you close this window or navigate away, all deposit and invoice
            selections made on this screen will be lost.
          </div>
          <div style="font-size: 13px; color: #605e5c; line-height: 1.6">
            You can return to this stage later to apply deposit deductions.
            Click <strong>Continue</strong> to proceed to the final review
            without saving deposit changes.
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" onclick="LT.closeModal('depositSkipModal')">
            ← Go Back
          </button>
          <button class="btn btn-primary" onclick="
              LT.closeModal('depositSkipModal');
              LT.goToStage(6);
            ">
            Continue →
          </button>
        </div>
      </div>
    </div>
    <!-- Saving Overlay -->
    <div id="savingOverlay" style="
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(123, 21, 21, 0.92);
        z-index: 8000;
        align-items: center;
        justify-content: center;
      ">
      <div style="text-align: center">
        <div class="loader"></div>
        <div id="loadingMessage" style="
            color: white;
            margin-top: 16px;
            font-size: 16px;
            font-weight: 600;
          ">
          Processing termination...
        </div>
      </div>
    </div>
 <script src="/WebResources/array_LeaseTerminationjs" defer></script>
    <noscript>
      <style>
        #loadingScreen {
          display: none !important;
        }
        #formContainer {
          opacity: 1 !important;
        }
      </style>
    </noscript>

    <script>
      window.addEventListener("DOMContentLoaded", function () {
        setTimeout(function () {
          var ls = document.getElementById("loadingScreen");
          var fc = document.getElementById("formContainer");
          if (ls && !ls.classList.contains("hidden")) {
            ls.classList.add("hidden");
            setTimeout(function () {
              ls.style.display = "none";
            }, 500);
          }
          if (fc && !fc.classList.contains("loaded"))
            fc.classList.add("loaded");
        }, 1000);
      });
    </script>
    <!-- ===== NEW CHARGE CONFIRM MODAL ===== -->
    <div class="modal" id="pendingChargesConfirmModal">
      <div class="modal-content" style="max-width: 500px">
        <div class="modal-header" style="background: linear-gradient(135deg, #2bad76, #0e6b0e)">
          <div class="modal-title">✅ New Charges Saved as Draft</div>
          <button class="modal-close" onclick="LT.closeModal('pendingChargesConfirmModal')">
            ×
          </button>
        </div>
        <div class="modal-body">
          <div style="
              background: #f0fdf4;
              border: 1px solid #86efac;
              border-left: 3px solid #2bad76;
              border-radius: 0 8px 8px 0;
              padding: 14px 16px;
              font-size: 13px;
              color: #166534;
              line-height: 1.7;
              margin-bottom: 14px;
            ">
            <strong><span id="pcm_chargeCount">0</span> new charge(s) have been saved
              with status <em>Draft</em>.</strong>
          </div>
          <div style="font-size: 13px; color: #605e5c; line-height: 1.7">
            These charges are currently in <strong>Draft</strong> status. They will be automatically
            <strong>activated</strong> when you click <strong>Submit</strong> on
            the final step.<br><br>
            Do you want to continue to the next step?
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" onclick="LT.closeModal('pendingChargesConfirmModal')">
            ← Go Back
          </button>
          <button class="btn btn-primary" onclick="LT._confirmPendingChargesContinue()">
            Continue →
          </button>
        </div>
      </div>
    </div>

    <!-- ===== RESET CONFIRM MODAL ===== -->
    <div class="modal" id="resetConfirmModal">
      <div class="modal-content" style="max-width: 520px">
        <div class="modal-header" style="background: linear-gradient(135deg, #7b1515, #a61c1c)">
          <div class="modal-title">↺ Reset Termination</div>
          <button class="modal-close" onclick="LT.closeModal('resetConfirmModal')">
            ×
          </button>
        </div>
        <div class="modal-body">
          <div style="
              background: #fef2f2;
              border: 1px solid #fecaca;
              border-left: 3px solid #a61c1c;
              border-radius: 0 8px 8px 0;
              padding: 14px 16px;
              font-size: 13px;
              color: #7b1515;
              line-height: 1.7;
              margin-bottom: 14px;
            ">
            This will undo <strong>ALL changes</strong> made during this
            termination process:
          </div>
          <ul style="
              font-size: 13px;
              color: #605e5c;
              line-height: 2;
              margin-left: 20px;
            ">
            <li>Clear exercised/effective dates on the break option</li>
            <li>Cancel the inspection work order</li>
            <li>Clear termination end dates on recurring charges</li>
            <li>Restore deposit status and clear adjusted amounts</li>
            <li>Deactivate the lease history record</li>
          </ul>
          <div style="
              margin-top: 14px;
              font-size: 13px;
              font-weight: 700;
              color: #7b1515;
            ">
            Are you sure you want to reset?
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" onclick="LT.closeModal('resetConfirmModal')">
            Cancel
          </button>
          <button class="btn btn-primary" onclick="LT._confirmReset()" style="background: linear-gradient(135deg, #7b1515, #a61c1c)">
            ↺ Yes, Reset Everything
          </button>
        </div>
      </div>
    </div>
  </body></html>