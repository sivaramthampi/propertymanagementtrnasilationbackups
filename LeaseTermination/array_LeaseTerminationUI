ckground:linear-gradient(180deg,#F9FAFB 0%,#F3F4F6 100%) !important;padding:12px 16px 12px 18px !important;border-bottom:1px solid #E5E7EB !important;border-left:4px solid #1C6BD4 !important;display:flex !important;align-items:center !important;gap:10px !important;transition:background 180ms ease,border-left-color 180ms ease;}.preview-section:hover .preview-section-header{background:linear-gradient(180deg,#EFF6FF 0%,#DBEAFE 100%) !important;border-left-color:#1E40AF !important;}.preview-section-title{color:#111827 !important;font-size:13px !important;font-weight:600 !important;letter-spacing:0.1px !important;margin:0 !important;flex:1 !important;display:flex !important;align-items:center !important;gap:8px !important;text-shadow:none !important;text-transform:none !important;}.preview-section-title svg,.preview-section-title i{color:#1C6BD4 !important;flex-shrink:0;width:16px;height:16px;}.preview-count-pill{background:#EFF6FF !important;color:#1E40AF !important;font-size:11px !important;font-weight:700 !important;padding:3px 10px !important;border-radius:999px !important;border:1px solid #BFDBFE !important;box-shadow:0 1px 2px rgba(28,107,212,0.08);white-space:nowrap;transition:background 140ms ease,color 140ms ease,border-color 140ms ease;}.preview-section:hover .preview-count-pill{background:#1C6BD4 !important;color:#fff !important;border-color:#1C6BD4 !important;}.preview-section .preview-count-pill[data-empty="true"]{background:#F3F4F6 !important;color:#6B7280 !important;border-color:#E5E7EB !important;}@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation-duration:0.01ms !important;transition-duration:0.01ms !important;}}</style></head>
  <body>
    <!-- Loading Screen — visible on boot, hidden by hideLoadingScreen() after init -->
    <div id="loadingScreen" class="hidden" style="display: none;">
      <div class="loader"></div>
      <div class="loading-text">Loading Lease Termination...</div>
    </div>

    <div class="form-container loaded" id="formContainer">
      <!-- Header -->
      <div class="form-header">
        <div class="header-content">
          <h1>🔴 Lease Termination Process</h1>
          <div class="header-meta">
            <span class="header-meta-item">Lease:
              <strong id="hdr_leaseId">—</strong></span>
            <span class="header-meta-sep">|</span>
            <span class="header-meta-item">Tenant:
              <strong id="hdr_tenant">—</strong></span>
            <span class="header-meta-sep">|</span>
            <span class="header-meta-item">Property:
              <strong id="hdr_property">—</strong></span>
            <span id="hdr_termTypeWrap" style="display: none">
              <span class="header-meta-sep">|</span>
              <span class="header-meta-item">Type: <strong id="hdr_termType"></strong></span>
            </span>
          </div>
        </div>
      </div>

      <!-- Stage Progress Bar — 6 stages -->
      <div class="stage-progress">
        <div class="progress-container">
          <div class="progress-line">
            <div class="progress-line-fill" id="progressFill" style="width: 0%;"></div>
          </div>
          <div class="stage-item active" id="stageTab1" onclick="LT.goToStage(1)">
            <div class="stage-circle">1</div>
            <div class="stage-label">Notice<br>Initiation</div>
          </div>
          <div class="stage-item" id="stageTab2" onclick="LT.goToStage(2)">
            <div class="stage-circle">2</div>
            <div class="stage-label">Move-out<br>Inspection</div>
          </div>
          <div class="stage-item" id="stageTab3" onclick="LT.goToStage(3)">
            <div class="stage-circle">3</div>
            <div class="stage-label">Charges &amp;<br>Proration</div>
          </div>
          <div class="stage-item" id="stageTab4" onclick="LT.goToStage(4)">
            <div class="stage-circle">4</div>
            <div class="stage-label">Financial<br>Clauses</div>
          </div>
          <div class="stage-item" id="stageTab5" onclick="LT.goToStage(5)">
            <div class="stage-circle">5</div>
            <div class="stage-label">Invoices &amp;<br>Deposits</div>
          </div>
          <div class="stage-item" id="stageTab6" onclick="LT.goToStage(6)">
            <div class="stage-circle">✓</div>
            <div class="stage-label">Final<br>Review</div>
          </div>
        </div>
      </div>

      <!-- ═══════════════ STAGE 1 ═══════════════ -->
      <div class="stage-content active" id="stage1">
        <div class="form-body">
          <div class="form-section">
            <div class="section-content">
              <div class="section-title">Notice Initiation</div>
              <div class="section-description">
                Record who is ending the lease, the notice and the move-out date.
              </div>
<div class="lease-info-strip" id="leaseInfoStrip"><div class="fetch-error" style="grid-column:1/-1;">⚠️ Could not load lease data: No record ID received.</div></div>

              <!-- Option A — pending amendments warning. Hidden by default,
                   shown by renderPendingAmendmentsBanner() if query finds any. -->
              <div id="pendingAmendmentsBanner" style="display:none;"></div>

              <div id="allOptionsPanel"></div>

              <div class="units-grid-header">🏢 Associated Units</div>
              <div class="units-grid" id="unitsGrid"><div class="fetch-error">⚠️ Could not load unit associations.</div></div>

              <hr class="moveout-section-divider">
              <div class="sub-section-header">📅 Termination Dates</div>
              <!-- Order per Rakesh feedback: Notice → Move-Out → Lease End -->
              <div class="form-grid">
                <div class="form-group full-width">
                  <label>Notice Given Date <span style="font-weight:400;color:#8a8886">— when the tenant was informed</span></label>
                  <input type="date" id="noticeGivenDate" onchange="LT.onNoticeGivenDateChange()">
                </div>
              </div>

              <hr class="moveout-section-divider">
              <div class="form-grid">
                <div class="form-group full-width">
                  <label class="required">Move-Out Date <span style="font-weight:400;color:#8a8886">— when the tenant vacates; frees the unit</span></label>
                  <input type="date" id="moveOutDate" onchange="LT.onMoveOutDateChange()">
                  <span style="font-size:11px;color:#8a8886;margin-top:3px">Can be before, on, or after the lease end date.</span>
                </div>
              </div>

              <hr class="moveout-section-divider">
              <div class="form-grid" style="margin-top: 14px">
                <div class="form-group full-width">
                  <label>Lease End Date <span style="font-weight:400;color:#8a8886">— drives billing</span></label>
                  <input type="date" id="leaseEndDate" onchange="LT.onLeaseEndDateChange()">
                  <span id="leaseEndDateHint" style="font-size: 11px; color: #8a8886; margin-top: 3px">
                    Rent bills to this date. Cannot exceed the original lease end date. Prefilled from the lease.
                  </span>
                </div>
              </div>
              <div id="moveOutTerminationAlert" class="validation-notice" style="display: none"></div>
              <div class="sub-section-header">
                📋 Who is initiating the termination?
              </div>
              <div class="initiator-toggle">
                <div class="initiator-btn active" id="initiatorTenant" onclick="LT.setInitiator('tenant')">
                  <span class="initiator-icon">🏠</span><span class="initiator-label">Tenant</span>
                </div>
                <div class="initiator-btn" id="initiatorLandlord" onclick="LT.setInitiator('landlord')">
                  <span class="initiator-icon">🏢</span><span class="initiator-label">Landlord</span>
                </div>
              </div>

              <!-- Existing Documents on Lease (view-only list) — populated by LT._renderExistingDocuments at boot. Hidden if no documents exist. -->
              <div id="existingDocumentsSection" style="display: none"></div>

              <div id="tenantUploadSection">
                <div class="sub-section-header">📎 Tenant Notice Document</div>
                <div class="form-group full-width">
                  <label>Upload Tenant Notice Letter</label>
                  <div class="file-upload-area" id="tenantUploadArea" onclick="document.getElementById('tenantFileInput').click()">
                    <div class="file-upload-icon">📄</div>
                    <div class="file-upload-text">
                      Click to upload or drag &amp; drop
                    </div>
                    <div class="file-upload-hint">
                      PDF, DOC, DOCX — max 5 MB
                    </div>
                    <div class="file-name-display" id="tenantFileName" style="display: none"></div>
                  </div>
                  <input type="file" id="tenantFileInput" accept=".pdf,.doc,.docx" style="display: none" onchange="LT.handleFileUpload('tenant', this)">
                </div>
              </div>

              <div id="landlordEmailSection" style="display: none">
                <div class="sub-section-header">📧 Landlord Notice Actions</div>
                <div class="toggle-group">
                  <div>
                    <div class="toggle-label">Send Notice Email to Tenant</div>
                    <div class="toggle-sub">
                      A notice email will be sent to the tenant's registered
                      email address.
                    </div>
                  </div>
                  <label class="toggle-switch"><input type="checkbox" id="sendEmailToggle" onchange="LT.toggleEmailFields(this.checked)"><span class="toggle-slider"></span></label>
                </div>
                <div id="emailFields" style="display: none; margin-top: 14px">
                  <div class="form-grid">
                    <div class="form-group">
                      <label>Tenant Email</label><input type="email" id="tenantEmail" placeholder="Loading tenant email..." readonly="readonly" class="lookup-field">
                    </div>
                    <div class="form-group">
                      <label>CC (optional)</label><input type="email" id="ccEmail" placeholder="cc@example.com">
                    </div>
                    <div class="form-group full-width">
                      <label>Email Subject</label><input type="text" id="emailSubject" value="Lease Termination Notice">
                    </div>
                    <div class="form-group full-width">
                      <label>Email Body</label>
                      <div style="display: flex; flex-direction: column; gap: 6px">
                        <div style="display: flex; justify-content: flex-end">
                          <button type="button" onclick="LT.toggleTemplateDropdown()" style="
                              padding: 5px 12px;
                              background: #0078d4;
                              color: white;
                              border: none;
                              border-radius: 5px;
                              font-size: 12px;
                              font-weight: 700;
                              cursor: pointer;
                              font-family: inherit;
                              display: flex;
                              align-items: center;
                              gap: 5px;
                            ">
                            📋 Templates
                          </button>
                        </div>
                        <div style="position: relative">
                          <textarea id="emailBody" rows="6" placeholder="Click the template button or type your message..." style="width: 100%; box-sizing: border-box">Dear Tenant, this is to formally notify you that the lease agreement is being terminated.</textarea>
                          <div id="emailTemplateDropdown" style="
                              display: none;
                              position: absolute;
                              top: 100%;
                              left: 0;
                              right: 0;
                              z-index: 500;
                              background: white;
                              border: 1.5px solid #edebe9;
                              border-radius: 8px;
                              box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
                              margin-top: 4px;
                              max-height: 280px;
                              overflow: hidden;
                              flex-direction: column;
                            ">
                            <div style="
                                padding: 10px 12px;
                                border-bottom: 1px solid #edebe9;
                                background: #faf9f8;
                              ">
                              <input type="text" id="templateSearchBox" placeholder="Search templates..." oninput="LT.filterTemplates(this.value)" onclick="event.stopPropagation()" style="
                                  width: 100%;
                                  padding: 7px 10px;
                                  border: 1.5px solid #edebe9;
                                  border-radius: 5px;
                                  font-size: 13px;
                                  font-family: inherit;
                                  outline: none;
                                ">
                            </div>
                            <div id="templateDropdownList" style="overflow-y: auto; max-height: 200px"></div>
                          </div>
                        </div>
                      </div>
                      <span style="font-size: 11px; color: #8a8886; margin-top: 3px">Click <strong>Templates</strong> to load and select
                        from Dynamics email templates.</span>
                    </div>
                  </div>
                </div>
                <div class="form-group full-width" style="margin-top: 14px">
                  <label>Upload &amp; Attach Notice Document</label>
                  <div class="file-upload-area" id="landlordUploadArea" onclick="
                      document.getElementById('landlordFileInput').click()
                    ">
                    <div class="file-upload-icon">📎</div>
                    <div class="file-upload-text">
                      Click to upload or drag &amp; drop
                    </div>
                    <div class="file-upload-hint">
                      Will be stored in Lease SharePoint folder — max 5 MB
                    </div>
                    <div class="file-name-display" id="landlordFileName" style="display: none"></div>
                  </div>
                  <input type="file" id="landlordFileInput" accept=".pdf,.doc,.docx" style="display: none" onchange="LT.handleFileUpload('landlord', this)">
                </div>
              </div>

              <div class="form-group full-width" style="margin-top: 18px">
                <label>Additional Notes / Reason for Termination</label>
                <textarea id="terminationNotes" rows="3" placeholder="Add any relevant notes about this termination..."></textarea>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══════════════ STAGE 2 ═══════════════ -->
      <div class="stage-content" id="stage2">
        <div class="form-body">
          <div class="form-section">
            <div class="section-content">
              <div class="section-title">Move-out Inspection</div>
              <div class="section-description">
                Optional — arrange the move-out inspection.
              </div>
<div class="wo-status-card not-created" id="woStatusCard">
                <div class="wo-status-icon" id="woStatusIcon">📋</div>
                <div style="flex: 1">
                  <div class="wo-status-label" id="woStatusLabel">Status</div>
                  <div class="wo-status-value" id="woStatusValue">
                    Work Order Not Created
                  </div>
                  <div class="wo-status-meta" id="woStatusMeta">
                    Create the inspection work order below, or continue without one.
                  </div>
                </div>
                <div class="wo-status-refresh" id="woRefreshBtn" style="display: none">
                  <button class="btn-refresh" onclick="LT.refreshWOStatus()">
                    🔄 Refresh
                  </button>
                </div>
              </div>

              <div class="case-created-banner" id="caseCreatedBanner" style="display: none">
                <span class="case-created-banner-icon">✅</span>
                <div>
                  <strong>Work Order Created:</strong>
                  <span id="caseWONumber">—</span>
                  <div style="
                      font-size: 12px;
                      font-weight: 500;
                      margin-top: 2px;
                      color: #166534;
                    ">
                    Fields are now view-only.
                  </div>
                </div>
              </div>

              <div class="case-create-card">
                <div class="case-create-card-header">
                  <div class="case-create-icon">🔧</div>
                  <div>
                    <div class="case-create-title">
                      Field Service Inspection Case
                    </div>
                  </div>
                </div>
                <div class="form-grid">
                  <div class="form-group">
                    <label class="required">Customer (Contact / Account)</label>
                    <div class="lookup-input-wrap">
                      <input type="text" id="caseCustomer" placeholder="Select customer..." class="lookup-field" readonly="readonly" style="cursor: pointer" onclick="LT.openCustomerLookup()">
                      <button class="lookup-trigger-btn" onclick="LT.openCustomerLookup()">🔍</button>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="required">Incident Type</label>
                    <div class="lookup-input-wrap">
                      <input type="text" id="caseIncidentTypeDisplay" placeholder="Select incident type..." class="lookup-field" readonly="readonly" style="cursor: pointer" onclick="LT.openIncidentTypeLookup()">
                      <button class="lookup-trigger-btn" onclick="LT.openIncidentTypeLookup()">🔍</button>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="required">Functional Location</label>
                    <div class="lookup-input-wrap">
                      <input type="text" id="caseFunctionalLocationDisplay" placeholder="Auto-filled from the unit..." class="lookup-field" readonly="readonly" style="cursor: pointer" onclick="LT.openFunctionalLocationLookup()">
                      <button class="lookup-trigger-btn" onclick="LT.openFunctionalLocationLookup()">🔍</button>
                    </div>
                  </div>
                  <div class="form-group full-width">
                    <label>Description</label>
                    <textarea id="caseDescription" rows="4" placeholder="Describe the inspection requirements..."></textarea>
                  </div>
                </div>
                <div class="case-action-row">
                  <button class="btn btn-blue" id="btnCreateCaseWO" onclick="LT.createWorkOrder()">
                    🔧 Create Work Order
                  </button>
                  <span style="font-size: 12px; color: #8a8886; margin-left: 4px" id="caseFormHint">
                    Click <strong>Create Work Order</strong> to generate a Termination Inspection work order in Field Service.
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══════════════ STAGE 3 — CHARGES ═══════════════ -->
      <div class="stage-content" id="stage3">
        <div class="form-body">
          <div class="form-section">
            <div class="section-content">
              <div class="section-title">Charges &amp; Proration</div>
              <div class="section-description">
                Check what will still be billed for each recurring charge.
              </div>
<div class="lease-info-strip-4col" id="s3InfoStrip">
                <div>
                  <div class="lease-info-strip-label">Move-Out Date</div>
                  <div class="lease-info-strip-value" id="s3MoveOutDate">—</div>
                </div>
                <div>
                  <div class="lease-info-strip-label">Recurring Charges</div>
                  <div class="lease-info-strip-value" id="s3ChargeCount">0</div>
                </div>
                <div>
                  <div class="lease-info-strip-label">Prorated Charges</div>
                  <div class="lease-info-strip-value" id="s3ProratedCount" style="color: #2bad76">0</div>
                </div>
                <div>
                  <div class="lease-info-strip-label">New Charges</div>
                  <div class="lease-info-strip-value" id="s3NewChargeCount">0</div>
                </div>
              </div>

              <div class="sub-section-header">🔄 Recurring Charges</div>
              <div class="charges-card-grid" id="chargesCardGrid">
                <div class="charges-loading-state">
                    <div class="charges-loading-spinner"></div>
                    <div class="charges-loading-text">Loading recurring charges from lease agreement…</div>
