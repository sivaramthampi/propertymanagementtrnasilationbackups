Screen{background:#ffffff !important;background-image:none !important;}.amend-body{overflow-x:visible !important;}.amend-table-wrapper{overflow-x:auto !important;-webkit-overflow-scrolling:touch;max-width:100%;}.amend-modal-overlay{display:flex !important;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 180ms ease-out,visibility 0s linear 180ms;will-change:opacity;}.amend-modal-overlay.active{opacity:1 !important;visibility:visible !important;pointer-events:auto !important;transition:opacity 180ms ease-out,visibility 0s linear 0s;}.amend-modal-overlay .amend-modal{transform:translateY(8px) scale(0.98);opacity:0;transition:transform 200ms cubic-bezier(0.16,1,0.3,1),opacity 200ms ease-out;will-change:transform,opacity;}.amend-modal-overlay.active .amend-modal{transform:translateY(0) scale(1);opacity:1;}.confirm-overlay{display:flex !important;opacity:0;visibility:hidden;pointer-events:none;transition:opacity 160ms ease-out,visibility 0s linear 160ms;}.confirm-overlay.active{opacity:1 !important;visibility:visible !important;pointer-events:auto !important;transition:opacity 160ms ease-out,visibility 0s linear 0s;}.tab-panel.active{animation:amendTabFade 180ms ease-out;}@keyframes amendTabFade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}.wizard-step{transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;}button,.amend-btn,.amend-btn-primary,.amend-btn-secondary{transition:background-color 140ms ease,border-color 140ms ease,box-shadow 140ms ease,transform 80ms ease;}button:active,.amend-btn:active{transform:translateY(1px);}input,select,textarea{transition:border-color 140ms ease,box-shadow 140ms ease,background-color 140ms ease;}.amend-table tbody tr{transition:background-color 120ms ease;}.amend-table-wrapper{min-height:60px;}.amend-table tbody{animation:amendTableFade 160ms ease-out;}@keyframes amendTableFade{from{opacity:0.4;}to{opacity:1;}}.amend-section,.amend-card{transition:opacity 14